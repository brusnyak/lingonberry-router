{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingonberry Router",
  "version": "0.1.0",
  "identifier": "dev.lingonberry.router",
  "build": {
    "beforeDevCommand": "npx vite --port 3000 --strictPort",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Local AI agent router menu bar app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/lingonberry-core"]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "url": "index.html#popover",
        "title": "Lingonberry Router",
        "width": 780,
        "height": 660,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8799 http://127.0.0.1:3000; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
    }
  }
}
